"language=en_US&bundleId=qvv1656594440497&topicId=Activate_your_Communications_Customer_Portal_account."
"html&_LANG=enus>`_."

#: ../../content/applications/finance/accounting/taxes/avatax/avalara_portal.rst:32
msgid "Transactions"
msgstr "Трансакции"

